# Vortex app credentials
# Client ID is safe to identify your app; Client Secret must NEVER be exposed to browsers or committed.
VORTEX_CLIENT_ID=vtx_4d21b21ace36baeb7916
VORTEX_CLIENT_SECRET=put-your-client-secret-here

# Express session signing secret (use a long random value in production)
SESSION_SECRET=replace-with-a-long-random-secret

# OAuth callback URL. Must be on a domain/IP allowed in Vortex Partner Tools -> Your Apps -> Where it works.
# Default for local development:
VORTEX_REDIRECT_URI=http://localhost:3000/auth/vortex/callback

# Optional: where the server listens
PORT=3000
BASE_URL=http://localhost:3000

# Optional: set to "true" when serving over HTTPS (production)
COOKIE_SECURE=false
